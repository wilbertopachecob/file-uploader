{
  "name": "upload-file",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite",
    "prebuild": "npm run lint:fix",
    "build": "vue-tsc && vite build --outDir ../server/public",
    "watch": "vite build --outDir ../server/public --watch",
    "test:unit": "vitest run",
    "test:ci": "vitest run --reporter=default --silent",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "core-js": "^3.50.0",
    "video.js": "^8.24.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@types/node": "^26.2.0",
    "@types/video.js": "^7.3.58",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}
