# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Base URL of the API server
VUE_APP_API_URL=http://localhost:3000

# Client log backend: console (default), sentry, or rollbar
# See README "Logging" for Sentry/Rollbar setup when enabling those backends.
VUE_APP_LOG_SERVICE=console

# Alternative Vite-native name (optional; VUE_APP_LOG_SERVICE takes precedence)
# VITE_LOG_SERVICE=console
